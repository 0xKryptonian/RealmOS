// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  walletAddress String         @unique // Legacy field for compatibility
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transactions  Transaction[]
  gamePlays     GamePlay[]
  gameScores    GameScore[]

  // User profile information
  username     String?   @unique
  avatar       String?   // IPFS hash or URL
  bio          String?
  NFTid        String?   // Profile NFT token ID
  
  // Hedera-specific fields
  hederaAccountId String? @unique // 0.0.xxxxx format
  hederaPublicKey String?
  profileNFTSerial String? // Serial number of profile NFT
  realmBalance    Float   @default(0) // Cached REALM token balance
  
  // Game-related relations
  userGames     UserGame[]
  createdEvents GameEvent[]
  eventParticipations EventParticipant[]
  ownedNFTs     NFT[]
  marketplaceListings MarketplaceListing[]
  marketplacePurchases MarketplacePurchase[]
  achievements  Achievement[]
  agentInteractions AgentInteraction[]
  streamingSessions StreamingSession[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// New models for user profile tracking

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  type          String   // "PAYMENT", "REWARD", etc.
  amount        Float
  tokenSymbol   String   @default("REALM")
  txHash        String?  // Blockchain transaction hash
  status        String   // "PENDING", "COMPLETED", "FAILED"
  description   String?
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Game model to store game information
model Game {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  imagePath     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  gamePlays     GamePlay[]
  gameScores    GameScore[]
  
  // Relations
  gameEvents    GameEvent[]
  userGames     UserGame[]
  
  @@index([slug])
  @@index([isActive])
}

// GameEvent model to store game-related events
model GameEvent {
  id            String    @id @default(cuid())
  title         String
  description   String
  imageUrl      String
  startTime     DateTime
  endTime       DateTime?
  location      String?   // Could be "online" or a physical location
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  gameId        String
  game          Game      @relation(fields: [gameId], references: [id])
  creatorId     String
  creator       User      @relation(fields: [creatorId], references: [id])
  participants  EventParticipant[]
  
  @@index([startTime])
  @@index([isActive])
  @@index([gameId])
}

// EventParticipant model to track event participation
model EventParticipant {
  id            String    @id @default(cuid())
  status        String    // "registered", "attended", "completed"
  registeredAt  DateTime  @default(now())
  
  // Relations
  eventId       String
  event         GameEvent @relation(fields: [eventId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  @@unique([eventId, userId])
}

// UserGame model to track user game progress and achievements
model UserGame {
  id            String    @id @default(cuid())
  score         Int       @default(0)
  highScore     Int       @default(0)
  playCount     Int       @default(0)
  lastPlayedAt  DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  gameId        String
  game          Game      @relation(fields: [gameId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  @@unique([gameId, userId])
  @@index([userId])
  @@index([highScore])
}

model GamePlay {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  playedAt  DateTime @default(now())
  duration  Int?     // in seconds
  completed Boolean  @default(false)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model GameScore {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  score     Int
  metadata  Json?    // Additional game-specific data
  achievedAt DateTime @default(now())
  txHash    String?  // Hedera transaction hash for HCS submission
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  @@index([score])
  @@index([achievedAt])
}

// Hedera Token Service (HTS) Token tracking
model Token {
  id            String   @id @default(cuid())
  tokenId       String   @unique // Hedera Token ID (0.0.xxxxx)
  name          String
  symbol        String
  type          String   // FUNGIBLE, NON_FUNGIBLE
  decimals      Int      @default(0)
  totalSupply   String?  // For fungible tokens
  treasuryId    String?  // Treasury account ID
  adminKey      String?  // Admin key (encrypted)
  supplyKey     String?  // Supply key (encrypted)
  metadata      Json?    // Additional token metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([tokenId])
  @@index([type])
}

// NFT tracking (HTS NFTs)
model NFT {
  id            String   @id @default(cuid())
  tokenId       String   // Token ID (0.0.xxxxx)
  serialNumber  String   // Serial number
  metadata      Json     // IPFS metadata URL and content
  owner         String   // Current owner Hedera Account ID
  userId        String?  // Associated user in our system
  category      String   // PROFILE, GAME_ASSET, ACHIEVEMENT, etc.
  rarity        String?  // COMMON, RARE, EPIC, LEGENDARY
  attributes    Json?    // NFT attributes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User?    @relation(fields: [userId], references: [id])
  listings      MarketplaceListing[]
  
  @@unique([tokenId, serialNumber])
  @@index([owner])
  @@index([category])
  @@index([rarity])
}

// HCS (Hedera Consensus Service) Message tracking
model HCSMessage {
  id                  String   @id @default(cuid())
  topicId             String   // HCS Topic ID (0.0.xxxxx)
  sequenceNumber      String
  message             Json     // Message content
  consensusTimestamp  String   // Hedera consensus timestamp
  type                String   // LEADERBOARD, GAME_EVENT, TOURNAMENT, etc.
  createdAt           DateTime @default(now())
  
  @@index([topicId])
  @@index([type])
  @@index([consensusTimestamp])
}

// Marketplace Listing
model MarketplaceListing {
  id            String   @id @default(cuid())
  nftId         String
  nft           NFT      @relation(fields: [nftId], references: [id])
  sellerId      String
  seller        User     @relation(fields: [sellerId], references: [id])
  price         String   // Price in HBAR (stored as string for precision)
  currency      String   @default("HBAR") // HBAR, REALM, etc.
  status        String   // ACTIVE, SOLD, CANCELLED
  listingType   String   // FIXED_PRICE, AUCTION
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  purchases     MarketplacePurchase[]
  
  @@index([status])
  @@index([sellerId])
  @@index([createdAt])
}

// Marketplace Purchase
model MarketplacePurchase {
  id            String   @id @default(cuid())
  listingId     String
  listing       MarketplaceListing @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User     @relation(fields: [buyerId], references: [id])
  price         String   // Final purchase price
  txHash        String   // Hedera transaction hash
  status        String   // PENDING, COMPLETED, FAILED
  createdAt     DateTime @default(now())
  
  @@index([buyerId])
  @@index([status])
}

// Achievement system
model Achievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String   // GAME_COMPLETION, HIGH_SCORE, TOURNAMENT_WIN, etc.
  gameId        String?
  title         String
  description   String
  nftTokenId    String?  // Associated NFT token ID
  nftSerial     String?  // Associated NFT serial number
  metadata      Json?
  earnedAt      DateTime @default(now())
  
  @@index([userId])
  @@index([type])
}

// AI Agent system
model AIAgent {
  id            String   @id @default(cuid())
  name          String
  type          String   // GAME_ASSISTANT, TOURNAMENT_MANAGER, REWARD_DISTRIBUTOR, NFT_GENERATOR
  status        String   // ACTIVE, INACTIVE, MAINTENANCE
  config        Json     // Agent configuration
  stats         Json?    // Usage statistics
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  interactions  AgentInteraction[]
  
  @@index([type])
  @@index([status])
}

// AI Agent Interactions
model AgentInteraction {
  id            String   @id @default(cuid())
  agentId       String
  agent         AIAgent  @relation(fields: [agentId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  type          String   // CHAT, TASK_EXECUTION, AUTOMATION
  input         Json     // User input or trigger
  output        Json?    // Agent response
  status        String   // PENDING, COMPLETED, FAILED
  cost          Float?   // API cost in USD
  createdAt     DateTime @default(now())
  
  @@index([agentId])
  @@index([userId])
  @@index([status])
}

// Tournament Prize Pool
model TournamentPrize {
  id            String   @id @default(cuid())
  eventId       String
  position      Int      // 1st, 2nd, 3rd, etc.
  prizeType     String   // HBAR, REALM, NFT
  amount        String?  // For token prizes
  nftTokenId    String?  // For NFT prizes
  nftSerial     String?
  winnerId      String?  // Winner user ID
  distributed   Boolean  @default(false)
  txHash        String?  // Distribution transaction hash
  createdAt     DateTime @default(now())
  
  @@index([eventId])
  @@index([winnerId])
}

// Streaming Session (Livepeer integration)
model StreamingSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  streamId      String   @unique // Livepeer stream ID
  streamKey     String   // Livepeer stream key for OBS
  playbackId    String?  // Livepeer playback ID
  rtmpUrl       String   @default("rtmp://rtmp.livepeer.com/live")
  title         String
  description   String?
  game          String?
  gameId        String?
  eventId       String?  // Link to GameEvent
  status        String   // LIVE, ENDED, SCHEDULED
  isLive        Boolean  @default(false)
  viewerCount   Int      @default(0)
  rewardPool    String?  // REALM tokens for viewers
  thumbnailUrl  String?
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([eventId])
  @@index([streamId])
  @@index([isLive])
}

// Guild System
model Guild {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  imageUrl      String?
  bannerUrl     String?
  founderId     String
  treasuryBalance String @default("0") // REALM tokens
  memberCount   Int      @default(1)
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  members       GuildMember[]
  tournaments   GuildTournament[]
  
  @@index([founderId])
  @@index([slug])
}

model GuildMember {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId        String
  role          String   // FOUNDER, ADMIN, MEMBER
  joinedAt      DateTime @default(now())
  contribution  String   @default("0") // REALM tokens contributed
  
  @@unique([guildId, userId])
  @@index([userId])
  @@index([guildId])
}

model GuildTournament {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  prizePool     String
  status        String   // UPCOMING, ACTIVE, COMPLETED
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
  
  @@index([guildId])
  @@index([status])
}

// Friend System
model Friendship {
  id            String   @id @default(cuid())
  requesterId   String
  addresseeId   String
  status        String   // PENDING, ACCEPTED, BLOCKED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

// Direct Messaging
model DirectMessage {
  id            String   @id @default(cuid())
  senderId      String
  receiverId    String
  content       String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// Community Events (Enhanced)
model CommunityEvent {
  id            String   @id @default(cuid())
  title         String
  description   String
  imageUrl      String
  eventType     String   // TOURNAMENT, LIVESTREAM, MEETUP, WORKSHOP
  startTime     DateTime
  endTime       DateTime?
  location      String?
  streamId      String?  // Link to StreamingSession
  prizePool     String?
  maxParticipants Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  participants  CommunityEventParticipant[]
  
  @@index([startTime])
  @@index([eventType])
  @@index([isActive])
}

model CommunityEventParticipant {
  id            String   @id @default(cuid())
  eventId       String
  event         CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  status        String   // REGISTERED, ATTENDED, COMPLETED
  registeredAt  DateTime @default(now())
  
  @@unique([eventId, userId])
  @@index([userId])
}

